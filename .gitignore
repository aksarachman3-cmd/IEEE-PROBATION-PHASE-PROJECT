# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# dev-server logs from running `npm run dev` with output redirected
dev.err
dev.log

# env files — real secrets stay out of git, but the template is committed so
# setup instructions are self-contained.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerate with `npm run db:generate`)
/src/generated/prisma

# local sqlite database (recreate with `npm run setup`)
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal

# user-uploaded event cover images (runtime data, not source)
# the directory itself is kept so a fresh clone has somewhere to write
/public/uploads/*
!/public/uploads/.gitkeep

# scratch database, uploads and logs created by `npm run smoke`
/.smoke/
/.next-smoke/
