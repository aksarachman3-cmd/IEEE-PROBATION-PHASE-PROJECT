# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed. Never commit real secrets.
#   cp .env.example .env
#
# Only DATABASE_URL and SESSION_SECRET are required. Everything else has a
# working default, so a fresh clone runs with this file copied and nothing else.
# ---------------------------------------------------------------------------

# SQLite database. The path is resolved from the project root, so this file
# will be created at <project-root>/prisma/dev.db.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to derive the session-token hash key (HMAC-SHA256).
# Must be at least 16 characters. In production the app REFUSES to start
# without this, rather than falling back to an insecure default.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# Absolute or relative path (from the project root) where uploaded event cover
# images are written. Defaults to ./public/uploads when omitted.
# NOTE: this must be a writable filesystem — see README section 9.
UPLOAD_DIR="./public/uploads"

# Public base URL, used for metadata/OG tags. Optional.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated CORS allow-list for the public read-only API endpoints.
# Leave empty to allow any origin. Credentials are never allowed, and the
# mutating verbs are never listed in Access-Control-Allow-Methods.
# API_ALLOWED_ORIGINS="https://events.ieee-itb.ac.id"

# ---------------------------------------------------------------------------
# Seed account — used only by `npm run db:seed`.
# Set these before seeding to create a different demo admin.
# The defaults are intentionally public throwaway credentials; change them
# before any real deployment.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@ieee-itb.ac.id"
SEED_ADMIN_PASSWORD="Admin#2026!"
SEED_ADMIN_NAME="Bagas Prakoso"
